{
  "manifest_version": 3,
  "name": "MX Readiness Inspector",
  "version": "0.2.0",
  "description": "Inspect the current page for MX-readiness signals (governance meta, AI disclosure, discovery files, structured data, accessibility) and summarise with the browser's on-device language model.",
  "author": "Tom Cranstoun",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MX Readiness Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
