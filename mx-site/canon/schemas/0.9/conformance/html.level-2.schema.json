{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mx.allabout.network/canon/schemas/0.9/conformance/html.level-2.schema.json",
  "title": "MX conformance Level 2 (Profiled), html profile, specification 0.9",
  "x-mx-profile": "html",
  "x-mx-level": 2,
  "x-mx-levelName": "Profiled",
  "x-mx-specVersion": "0.9",
  "$defs": {
    "hasValue": {
      "not": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^\\s*$"
          },
          {
            "type": "array",
            "maxItems": 0
          },
          {
            "type": "object",
            "maxProperties": 0
          }
        ]
      }
    }
  },
  "description": "Every field the html profile requires.",
  "x-mx-fields": [
    "title",
    "description",
    "author",
    "created",
    "modified",
    "mx:name"
  ],
  "type": "object",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "description"
          ],
          "properties": {
            "description": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "author"
          ],
          "properties": {
            "author": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "author"
              ],
              "properties": {
                "author": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "created"
          ],
          "properties": {
            "created": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "created"
              ],
              "properties": {
                "created": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "modified"
          ],
          "properties": {
            "modified": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "modified"
              ],
              "properties": {
                "modified": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "mx:name"
          ],
          "properties": {
            "mx:name": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "mx:name"
              ],
              "properties": {
                "mx:name": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
