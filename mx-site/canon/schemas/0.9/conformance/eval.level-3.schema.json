{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mx.allabout.network/canon/schemas/0.9/conformance/eval.level-3.schema.json",
  "title": "MX conformance Level 3 (Attested), eval profile, specification 0.9",
  "x-mx-profile": "eval",
  "x-mx-level": 3,
  "x-mx-levelName": "Attested",
  "x-mx-specVersion": "0.9",
  "$defs": {
    "hasValue": {
      "not": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^\\s*$"
          },
          {
            "type": "array",
            "maxItems": 0
          },
          {
            "type": "object",
            "maxProperties": 0
          }
        ]
      }
    }
  },
  "description": "An envelope holding a eval document that meets Level 2 and the attestation record the caller verified. The schema checks the shape of that evidence; verifying the attestation is the client's work.",
  "x-mx-fields": [
    "title",
    "description",
    "author",
    "created",
    "modified",
    "evalTask",
    "evalSubjects",
    "evalGrading",
    "evalRuns"
  ],
  "type": "object",
  "required": [
    "document",
    "attestation"
  ],
  "properties": {
    "document": {
      "type": "object",
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "properties": {
                    "title": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "description"
                  ],
                  "properties": {
                    "description": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "author"
              ],
              "properties": {
                "author": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "author"
                  ],
                  "properties": {
                    "author": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "created"
              ],
              "properties": {
                "created": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "created"
                  ],
                  "properties": {
                    "created": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "modified"
              ],
              "properties": {
                "modified": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "modified"
                  ],
                  "properties": {
                    "modified": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "evalTask"
              ],
              "properties": {
                "evalTask": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "evalTask"
                  ],
                  "properties": {
                    "evalTask": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "evalSubjects"
              ],
              "properties": {
                "evalSubjects": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "evalSubjects"
                  ],
                  "properties": {
                    "evalSubjects": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "evalGrading"
              ],
              "properties": {
                "evalGrading": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "evalGrading"
                  ],
                  "properties": {
                    "evalGrading": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "evalRuns"
              ],
              "properties": {
                "evalRuns": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            },
            {
              "required": [
                "mx"
              ],
              "properties": {
                "mx": {
                  "type": "object",
                  "required": [
                    "evalRuns"
                  ],
                  "properties": {
                    "evalRuns": {
                      "$ref": "#/$defs/hasValue"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "attestation": {
      "type": "object",
      "required": [
        "verified"
      ],
      "properties": {
        "verified": {
          "const": true
        }
      }
    }
  }
}
