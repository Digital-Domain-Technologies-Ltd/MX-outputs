{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mx.allabout.network/canon/schemas/0.9/conformance/folder.level-1.schema.json",
  "title": "MX conformance Level 1 (Declared), folder profile, specification 0.9",
  "x-mx-profile": "folder",
  "x-mx-level": 1,
  "x-mx-levelName": "Declared",
  "x-mx-specVersion": "0.9",
  "$defs": {
    "hasValue": {
      "not": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^\\s*$"
          },
          {
            "type": "array",
            "maxItems": 0
          },
          {
            "type": "object",
            "maxProperties": 0
          }
        ]
      }
    }
  },
  "description": "The fields a folder document carries to meet Level 1: the required fields its author writes, plus the derived fields a tool writes.",
  "x-mx-fields": [
    "title",
    "description",
    "domain",
    "folderType",
    "lifecycle"
  ],
  "type": "object",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "description"
          ],
          "properties": {
            "description": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "domain"
          ],
          "properties": {
            "domain": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "domain"
              ],
              "properties": {
                "domain": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "folderType"
          ],
          "properties": {
            "folderType": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "folderType"
              ],
              "properties": {
                "folderType": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "lifecycle"
          ],
          "properties": {
            "lifecycle": {
              "$ref": "#/$defs/hasValue"
            }
          }
        },
        {
          "required": [
            "mx"
          ],
          "properties": {
            "mx": {
              "type": "object",
              "required": [
                "lifecycle"
              ],
              "properties": {
                "lifecycle": {
                  "$ref": "#/$defs/hasValue"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
