# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Office / Keynote lock files (created while a doc is open)
~$*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary build directories
/tmp/
/temp/
.cache/

# Editor directories
.vscode/
.idea/
*.sublime-*

# Environment files
.env
.env.local
.env.*.local

# Node modules
node_modules/

# Lock directory for generate-index.sh concurrency guard
.generate-index.lock/
# Cache file for generate-index.sh single-pass directory walk
.generate-index-cache.tsv

# Audit pipeline intermediate artefacts: pre-rewrite skeletons + verifier
# sidecars written by infill-report.js before the rewrite pass. Lives next
# to each audit's deliverables for local diffing; never shipped.
.infilled/

# Audit pipeline raw data — consolidated into mx-outputs/audit/ by domain
# as of 2026-05-26. The leading-dot folders are infrastructure, not
# deliverables, so they stay out of the submodule:
#   audit/<hostSlug>/.cache/          per-domain HTML + origin cache (shared across dates)
#   audit/<hostSlug>/.history.jsonl   per-domain history of audit runs
#   audit/<date>/<hostSlug>/.infill/  raw audit results + template/methodology snapshot
#   audit/.benchmarks/                cross-domain peer-scores dataset
#   audit/findings/.contrib/          per-domain trail contributions: the out-of-band
#                                     key that maps a domain to the platform wrinkles it
#                                     contributed, so a re-audit deletes its previous run.
#                                     Holds the domain; the committed trail stays anonymised.
#   audit/<hostSlug>/.lock            same-slug concurrency lock (PID + start time)
# Dated delivery folders — deliveries now live in per-domain Gitea repos.
# The pattern prevents a new audit run from accidentally re-staging them.
audit/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
audit/**/.cache/
audit/**/.infill/
audit/.benchmarks/
audit/**/.history.jsonl
audit/**/.lock
audit/findings/.contrib/
# Intent CMS import fidelity screenshots — heavy binaries (original/regenerated/diff
# PNGs). The committed evidence is fidelity.json + the provenance sidecar; the PNGs
# regenerate on the next import run.
audit/intent-import/**/*.png
# Intent CMS captured assets — downloaded third-party binaries (images/fonts).
# They carry MX metadata on disk (XMP / .mx.yaml sidecar) but are not committed.
audit/intent-import/**/assets/**

# Confidential strategy companion to business-plan.md — rendered PDF and any
# adjacent provenance sidecars. Source .md is gitignored in the hub .gitignore.
# Restricted to DDT board and CogNovaMX directors.
pdf/The Possible Future.*

# Python bytecode cache
__pycache__/
*.pyc
